# ---------------------------------------------------------------------------
# Basis
# ---------------------------------------------------------------------------
# Oeffentliche URL der Seite (ohne abschliessenden Slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Zufaelliges Geheimnis fuer Login-Cookies (min. 32 Zeichen)
# erzeugen z.B. mit:  openssl rand -base64 48
AUTH_SECRET=bitte-durch-ein-langes-zufallsgeheimnis-ersetzen-min-32-zeichen

# ---------------------------------------------------------------------------
# Admin-Zugang (Inhaber)
# ---------------------------------------------------------------------------
ADMIN_EMAIL=admin@example.com
# Passwort-Hash erzeugen mit:  npm run seed -- --admin-password "DeinPasswort"
# Alternativ (nur fuer lokale Tests) Klartext via ADMIN_PASSWORD.
ADMIN_PASSWORD_HASH=
ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Datenbank
# ---------------------------------------------------------------------------
# Ohne Supabase-Variablen laeuft die Seite mit einer lokalen JSON-Datei
# (data/store.local.json) - ideal zum Ausprobieren, NICHT fuer Produktion.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Stripe
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Preis-IDs aus dem Stripe-Dashboard (npm run stripe:setup legt sie an)
STRIPE_PRICE_BASIC_MONTHLY=
STRIPE_PRICE_BASIC_YEARLY=
STRIPE_PRICE_BLACK_MONTHLY=
STRIPE_PRICE_BLACK_YEARLY=
STRIPE_PRICE_PLATIN_MONTHLY=
STRIPE_PRICE_PLATIN_YEARLY=

# Zahlungsarten im Checkout (Komma-getrennt).
# "auto" = im Stripe-Dashboard konfigurierte Methoden automatisch verwenden.
# Fuer Deutschland sinnvoll: card,paypal,sepa_debit,link
STRIPE_PAYMENT_METHODS=card,paypal,sepa_debit

# ---------------------------------------------------------------------------
# Impressum / Anbieterkennzeichnung (§5 DDG, §18 MStV)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_COMPANY_NAME=Muster Research GmbH
NEXT_PUBLIC_COMPANY_LEGAL_FORM=Gesellschaft mit beschraenkter Haftung
NEXT_PUBLIC_COMPANY_STREET=Musterstrasse 1
NEXT_PUBLIC_COMPANY_CITY=70178 Stuttgart
NEXT_PUBLIC_COMPANY_COUNTRY=Deutschland
NEXT_PUBLIC_COMPANY_EMAIL=kontakt@example.com
NEXT_PUBLIC_COMPANY_PHONE=+49 711 0000000
NEXT_PUBLIC_COMPANY_MANAGING_DIRECTOR=Max Mustermann
NEXT_PUBLIC_COMPANY_REGISTER=Amtsgericht Stuttgart, HRB 000000
NEXT_PUBLIC_COMPANY_VAT_ID=DE000000000
